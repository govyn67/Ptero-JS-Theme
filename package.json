{
  "name": "ptero-js-theme",
  "version": "1.0.0",
  "description": "Clean & modern theme for ptero-js (Node.js Pterodactyl panel fork)",
  "main": "theme/js/ptero-theme.js",
  "types": "theme/ts/ptero-theme.ts",
  "style": "theme/css/ptero-theme.css",
  "scripts": {
    "build": "tsc theme/ts/ptero-theme.ts --outDir theme/js --target ES2020 --module ESNext --moduleResolution node --strict --esModuleInterop",
    "watch": "tsc theme/ts/ptero-theme.ts --outDir theme/js --watch",
    "install:panel": "bash install.sh",
    "lint": "eslint theme/js theme/ts || true",
    "server": "node server/index.js"
  },
  "keywords": [
    "pterodactyl",
    "ptero-js",
    "theme",
    "panel",
    "hosting",
    "modrinth",
    "spigot",
    "curseforge",
    "paper",
    "forge",
    "fabric",
    "velocity",
    "bungeecord"
  ],
  "author": "PteroJS Theme",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jishnuthegamer/ptero-js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "node-fetch": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
